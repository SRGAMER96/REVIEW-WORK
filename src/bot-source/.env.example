# ==========================================
# 🤖 Telegram Bot Configuration
# ==========================================

# Obtain your bot token from @BotFather on Telegram
BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"

# Your Telegram User ID (obtain from @userinfobot or @raw_data_bot)
# ONLY this user will have access to the Admin Control Panel
ADMIN_USER_ID="123456789"

# MongoDB Database Connection URI (MongoDB Atlas or Local MongoDB)
# Example Local: mongodb://localhost:27017/telegram_review_bot
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/telegram_review_bot?retryWrites=true&w=majority
MONGO_URI="mongodb://localhost:27017/telegram_review_bot"

# Official Support Username (without @ symbol)
SUPPORT_USERNAME="YourSupportUsername"
